---
// src/pages/index.astro
import Navbar from '../components/Navbar.astro';
import HeroBento from '../components/HeroBento.astro';
import CatalogoProductos from '../components/CatalogoProductos.astro';
import CasosEstudio from '../components/CasosEstudio.astro';
import CotizadorSoftware from '../components/CotizadorSoftware';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const titulo = "Sebastian | Senior Fullstack Architect & Software Solutions";
const descripcion = "Diseño arquitecturas escalables, APIs Clean Architecture (.NET, Django, Node) y plataformas web de alto rendimiento con latencias sub-100ms y disponibilidad del 99.99%.";
const urlSitio = "https://sebastian.dev";
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Primario -->
    <title>{titulo}</title>
    <meta name="title" content={titulo} />
    <meta name="description" content={descripcion} />
    <meta name="keywords" content="Arquitecto de Software, Fullstack Developer, .NET Clean Architecture, Angular 22 Signals, Astro 5, Docker, Neon Postgres, Cotizador de Software" />
    <meta name="author" content="Sebastian" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlSitio} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={urlSitio} />
    <meta property="twitter:title" content={titulo} />
    <meta property="twitter:description" content={descripcion} />

    <!-- JSON-LD Datos Estructurados Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Sebastian",
      "jobTitle": "Senior Fullstack Architect & Software Engineer",
      "description": descripcion,
      "url": urlSitio,
      "knowsAbout": [
        "Software Architecture",
        "Clean Architecture",
        ".NET 9",
        "Angular 22",
        "PostgreSQL",
        "Docker",
        "Cloud Deployment"
      ]
    })} />
  </head>
  <body class="bg-[#090A0F] text-slate-100 min-h-screen relative overflow-x-hidden selection:bg-cyan-400 selection:text-slate-950">
    <!-- Fondos de atmósfera cinemática (Aurora Mesh) -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
      <!-- Glow superior cian -->
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[450px] bg-cyan-500/10 blur-[130px] rounded-full"></div>
      <!-- Glow intermedio índigo -->
      <div class="absolute top-[40%] right-[-10%] w-[550px] h-[550px] bg-indigo-600/10 blur-[140px] rounded-full"></div>
      <!-- Rejilla tecnológica tenue de fondo -->
      <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)]"></div>
    </div>

    <!-- Barra de Navegación -->
    <Navbar />

    <main>
      <!-- Hero Bento Section -->
      <HeroBento />

      <!-- Catálogo de Productos y Soluciones a la Medida -->
      <CatalogoProductos />

      <!-- Casos de Estudio de Alto Rendimiento -->
      <CasosEstudio />

      <!-- Elemento Firma: Cotizador Interactivo de Software (React Island) -->
      <section id="cotizador" class="py-16 sm:py-24 px-4 sm:px-6 max-w-6xl mx-auto">
        <div class="mb-10 text-center">
          <span class="text-xs font-mono uppercase tracking-wider text-cyan-400 block mb-2">
            Elemento Firma Reactivo
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            Cotizador Interactivo de Software
          </h2>
          <p class="text-slate-400 text-sm sm:text-base max-w-xl mx-auto mt-2 font-normal">
            Configura las especificaciones técnicas de tu requerimiento en tiempo real y recibe un desglose instantáneo listo para coordinar por WhatsApp.
          </p>
        </div>

        <!-- Isla React con hidratación diferida al ser visible -->
        <CotizadorSoftware client:visible />
      </section>
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
