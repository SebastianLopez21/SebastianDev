---
interface Props {
  nombre?: string;
  propuestaValor?: string;
}

const {
  nombre = "Sebastian",
  propuestaValor = "Diseño arquitecturas escalables, APIs Clean Architecture y plataformas web con latencias sub-100ms y disponibilidad del 99.99%."
} = Astro.props;
---

<section class="py-12 sm:py-20 px-4 sm:px-6 max-w-6xl mx-auto">
  <!-- Status pill superior -->
  <div class="flex justify-center mb-6">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-950/60 border border-emerald-500/30 text-xs font-mono text-emerald-300 shadow-lg shadow-emerald-950/50">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      <span>Disponible para nuevos proyectos & consultoría de arquitectura</span>
    </div>
  </div>

  <!-- Bento Grid Hero Asimétrico -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
    <!-- Card Principal (8 Cols en desktop) -->
    <div class="lg:col-span-8 rounded-3xl p-8 sm:p-12 bg-gradient-to-br from-[#0F121C] via-[#0D101A] to-[#090A0F] border border-white/[0.08] relative overflow-hidden flex flex-col justify-between">
      <!-- Resplandor ambiental de fondo -->
      <div class="absolute -top-24 -right-24 w-80 h-80 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none"></div>

      <div>
        <span class="text-xs font-mono uppercase tracking-wider text-cyan-400 block mb-3">
          Arquitectura de Software & Desarrollo Fullstack
        </span>
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.1]">
          {nombre}
        </h1>
        <p class="text-slate-300 text-base sm:text-xl max-w-2xl mt-5 font-normal leading-relaxed">
          {propuestaValor}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-4 mt-8 pt-6 border-t border-white/[0.06]">
        <a
          href="#cotizador"
          class="btn-tactile px-6 py-3.5 rounded-xl bg-cyan-400 text-slate-950 font-bold text-xs sm:text-sm tracking-wide shadow-lg shadow-cyan-400/20 hover:bg-cyan-300"
        >
          ⚡ Calcular Presupuesto en Vivo
        </a>
        <a
          href="#soluciones"
          class="btn-tactile px-6 py-3.5 rounded-xl bg-white/[0.05] border border-white/[0.1] text-slate-200 font-semibold text-xs sm:text-sm hover:bg-white/[0.1] hover:border-white/[0.2]"
        >
          Explorar Productos a la Medida
        </a>
      </div>
    </div>

    <!-- Columna Derecha Bento (4 Cols en desktop) -->
    <div class="lg:col-span-4 flex flex-col gap-5">
      <!-- Card Métrica en Vivo (Latencia) -->
      <div class="card-hover-lift rounded-3xl p-6 bg-[#0F121C] border border-white/[0.08] relative overflow-hidden">
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs font-mono text-slate-400 uppercase">Benchmark en Producción</span>
          <span class="px-2 py-0.5 rounded-full text-[10px] font-mono bg-emerald-950 text-emerald-400 border border-emerald-800">
            SLA Verificado
          </span>
        </div>
        <div class="text-4xl font-black font-mono text-emerald-400 tracking-tight">
          &lt; 85ms
        </div>
        <div class="text-xs text-slate-300 mt-1 font-medium">Latencia p95 bajo carga concurrente</div>
        <div class="mt-4 pt-3 border-t border-white/[0.06] flex items-center justify-between text-[11px] text-slate-400 font-mono">
          <span>0.00% Errores 500</span>
          <span>100% OnPush Signals</span>
        </div>
      </div>

      <!-- Card Stack Tecnológico Maestro -->
      <div class="card-hover-lift rounded-3xl p-6 bg-[#0F121C] border border-white/[0.08]">
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-wider block mb-3">
          Stack Central
        </span>
        <div class="flex flex-wrap gap-2">
          <span class="text-xs font-mono px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-slate-200">
            .NET 9 Clean Arch
          </span>
          <span class="text-xs font-mono px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-slate-200">
            Angular 22 Signals
          </span>
          <span class="text-xs font-mono px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-slate-200">
            Astro 5 + React
          </span>
          <span class="text-xs font-mono px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-slate-200">
            Neon PostgreSQL
          </span>
          <span class="text-xs font-mono px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/[0.08] text-slate-200">
            Docker & OCI Cloud
          </span>
        </div>
        <p class="text-[11px] text-slate-400 mt-3 leading-relaxed">
          Arquitectura desacoplada, tipado estricto y cero dependencias de infraestructura en capas de negocio.
        </p>
      </div>
    </div>
  </div>
</section>
