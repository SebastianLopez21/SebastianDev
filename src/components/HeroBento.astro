---
// src/components/HeroBento.astro
import CyberCommandCenter from './CyberCommandCenter';

interface Props {
  nombre?: string;
  propuestaValor?: string;
}

const {
  nombre = "Sebastian",
  propuestaValor = "Diseño arquitecturas escalables, APIs Clean Architecture (.NET, Django, Node) y plataformas web de alto rendimiento con latencias sub-50ms y disponibilidad del 99.99%."
} = Astro.props;
---

<section class="py-12 sm:py-20 px-4 sm:px-6 max-w-6xl mx-auto">
  <!-- Status pill superior -->
  <div class="flex justify-center mb-8">
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-emerald-950/60 border border-emerald-500/30 text-xs font-mono text-emerald-300 shadow-lg shadow-emerald-950/50">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>Disponible para nuevos proyectos & consultoría de arquitectura</span>
      <span class="text-slate-500 hidden sm:inline">•</span>
      <span class="text-cyan-300 hidden sm:inline font-semibold">SLA 99.99%</span>
    </div>
  </div>

  <!-- Hero Grid: Propuesta de Valor + Cyber Command Center -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
    <!-- Columna Izquierda: Introducción & Propuesta de Valor (5 Cols) -->
    <div class="lg:col-span-5 spotlight-card rounded-3xl p-7 sm:p-9 flex flex-col justify-between relative overflow-hidden">
      <!-- Glow ambiental de fondo -->
      <div class="absolute -top-24 -left-24 w-80 h-80 rounded-full bg-cyan-500/10 blur-3xl pointer-events-none"></div>

      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="text-cyan-400 font-bold text-xs">✦</span>
          <span class="text-xs font-mono uppercase tracking-wider text-cyan-300 font-semibold">
            Senior Fullstack Architect
          </span>
        </div>

        <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight leading-[1.08]">
          {nombre} <br />
          <span class="text-gradient-cyan-violet">Software Solutions</span><span class="text-cyan-400 animate-cursor-blink font-mono font-light ml-1 inline-block">_</span>
        </h1>

        <p class="text-slate-300 text-sm sm:text-base mt-4 font-normal leading-relaxed">
          {propuestaValor}
        </p>

        <!-- Métricas Rápidas en Mini-Grid -->
        <div class="grid grid-cols-2 gap-3 mt-6 pt-6 border-t border-white/[0.08] font-mono text-xs">
          <div class="p-3 rounded-2xl bg-white/[0.03] border border-white/[0.06]">
            <span class="text-[10px] text-slate-400 block uppercase">Latencia p95</span>
            <span class="text-emerald-400 font-black text-lg">&lt; 42ms</span>
          </div>
          <div class="p-3 rounded-2xl bg-white/[0.03] border border-white/[0.06]">
            <span class="text-[10px] text-slate-400 block uppercase">Errores HTTP</span>
            <span class="text-cyan-300 font-black text-lg">0.00%</span>
          </div>
        </div>
      </div>

      <!-- Acciones Táctiles -->
      <div class="flex flex-col sm:flex-row items-stretch gap-3 mt-8 pt-6 border-t border-white/[0.06]">
        <a
          href="#cotizador"
          class="btn-tactile px-6 py-3.5 rounded-xl bg-cyan-400 text-slate-950 font-bold text-xs tracking-wide shadow-lg shadow-cyan-400/20 hover:bg-cyan-300 text-center"
        >
          ⚡ Cotizar Proyecto
        </a>
        <a
          href="#soluciones"
          class="btn-tactile px-5 py-3.5 rounded-xl bg-white/[0.04] border border-white/[0.1] text-slate-200 font-semibold text-xs hover:bg-white/[0.08] text-center"
        >
          Explorar Productos
        </a>
      </div>
    </div>

    <!-- Columna Derecha: The Cyber Command Center (7 Cols) -->
    <div class="lg:col-span-7 flex flex-col justify-center">
      <CyberCommandCenter client:load />
    </div>
  </div>
</section>
